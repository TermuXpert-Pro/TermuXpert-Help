    <script src="assets/js/vendor/gsap.min.js"></script>

    <style>
        /* ====== تصميم خاص بصفحة installation.html فقط ====== */
        html{scroll-behavior:smooth;}

        /* ====== شبكة الفوائد ====== */
        .install-benefit-grid{
            display:grid; grid-template-columns:1fr; gap:12px; margin-top:14px;
        }
        @media (min-width:600px){
            .install-benefit-grid{grid-template-columns:1fr 1fr;}
        }
        .install-benefit-card{
            display:flex; align-items:flex-start; gap:12px;
            background:rgba(var(--overlay-rgb), 0.03);
            border:1px solid var(--border);
            border-radius:12px;
            padding:14px;
        }
        .install-benefit-card i{
            font-size:18px; color:var(--legal-teal); margin-top:2px; flex-shrink:0;
        }
        .install-benefit-card .install-benefit-title{
            font-weight:700; color:var(--text-primary); font-size:14px;
            margin-bottom:4px; font-family:'Cairo','Tajawal',sans-serif;
        }
        .install-benefit-card .install-benefit-desc{
            font-size:13px; color:var(--text-secondary); line-height:1.7;
            font-family:'Cairo','Tajawal',sans-serif;
        }

        /* ====== خطوات التثبيت ====== */
        .install-steps{
            list-style:none; padding:0; margin-top:14px; counter-reset:step;
        }
        .install-steps li{
            display:flex; align-items:flex-start; gap:14px;
            margin-bottom:16px; padding-bottom:16px;
            border-bottom:1px dashed var(--border);
        }
        .install-steps li:last-child{border-bottom:none; margin-bottom:0; padding-bottom:0;}
        .install-step-num{
            counter-increment:step;
            flex-shrink:0; width:30px; height:30px; border-radius:50%;
            background:rgba(78,205,196,0.12); border:1px solid rgba(78,205,196,0.35);
            color:var(--legal-teal); font-weight:900; font-size:14px;
            display:flex; align-items:center; justify-content:center;
            font-family:'Cairo','Tajawal',sans-serif;
        }
        .install-step-num::before{content:counter(step);}
        .install-step-text{font-size:14px; line-height:1.8; color:var(--text-secondary); font-family:'Cairo','Tajawal',sans-serif;}
        .install-step-text strong{color:var(--text-primary);}
        .install-step-text code{
            background:rgba(var(--overlay-rgb), 0.06); padding:2px 8px; border-radius:6px;
            color:var(--gold-text); font-size:13px; direction:ltr; display:inline-block;
        }

        /* ====== تبويبات الجهاز ====== */
        .install-device-tag{
            display:inline-flex; align-items:center; gap:6px;
            background:rgba(244,208,63,0.1); border:1px solid rgba(244,208,63,0.3);
            color:var(--gold-text); font-size:12px; font-weight:700;
            padding:4px 12px; border-radius:16px; margin-bottom:10px;
            font-family:'Cairo','Tajawal',sans-serif;
        }
        /* ====== ملاحظة اختصار (كتشير للزر الكبير فالأعلى) ====== */
        .install-shortcut{
            display:flex; align-items:flex-start; gap:10px;
            background:rgba(78,205,196,0.08);
            border:1px solid rgba(78,205,196,0.3);
            border-radius:12px;
            padding:12px 14px;
            margin-bottom:16px;
        }
        .install-shortcut i{
            font-size:16px; color:var(--legal-teal); margin-top:2px; flex-shrink:0;
        }
        .install-shortcut span{
            font-size:13px; line-height:1.8; color:var(--text-secondary);
            font-family:'Cairo','Tajawal',sans-serif;
        }
        .install-shortcut a{
            color:var(--legal-teal); font-weight:700; text-decoration:none;
            border-bottom:1px dashed var(--legal-teal);
        }
        .install-shortcut a:hover{ opacity:0.8; }

        /* ====== زر تحميل كبير (CTA) فصفحة التثبيت ====== */
        .install-cta-btn{
            display:inline-flex; align-items:center; gap:10px;
            margin-top:20px; padding:14px 28px;
            background:linear-gradient(135deg, var(--legal-teal), #45A29E);
            color:#0B0C10; font-weight:800; font-size:15px;
            border:none; border-radius:14px; cursor:pointer;
            font-family:'Cairo','Tajawal',sans-serif;
            box-shadow:0 6px 24px rgba(78,205,196,0.28);
            transition:transform 0.2s ease, box-shadow 0.2s ease;
        }
        .install-cta-btn:hover{ transform:translateY(-2px); box-shadow:0 10px 30px rgba(78,205,196,0.35); }
        .install-cta-btn:active{ transform:translateY(0) scale(0.97); }
        .install-cta-btn i{ font-size:16px; }
        .install-cta-note{
            margin-top:10px; font-size:12px; color:var(--text-muted);
            font-family:'Cairo','Tajawal',sans-serif;
        }
    </style>
</head>
<body>
    <div id="xpertLoader" role="status" aria-label="جاري التحميل">
        <div class="xpert-shape-wrap">
            <div class="xpert-ring"></div>
            <div class="xpert-orbit"><span class="xpert-orbit-dot"></span></div>
            <div class="xpert-shape-glow"></div>
            <div class="xpert-shape"></div>
        </div>
    </div>


