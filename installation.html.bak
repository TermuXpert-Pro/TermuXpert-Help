    <!-- ====== زر التحميل الكبير - كيستعمل نفس منطق script.js ====== -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var btn = document.getElementById('installPageBtn');
        if (!btn) return;
        btn.addEventListener('click', function () {
            if (window.XpertPWAInstall) {
                window.XpertPWAInstall();
            } else {
                alert('التثبيت غير متاح حالياً، جرّب من قائمة المتصفح (⋮) → "تثبيت التطبيق".');
            }
        });
    });
    </script>
<!-- ====== GSAP Animation (دالة مشتركة فـ script.js) ======
     تأخير 500ms عشان الأنيميشن تبدا بعد اختفاء اللودر (xpertLoader
     كياخد 500ms كحد أدنى قبل ما يختفي - MIN_DISPLAY فـ script.js). -->
<script>
setTimeout(function () {
    XpertAnimateLegalPage('installation.html');
}, 500);
</script>

