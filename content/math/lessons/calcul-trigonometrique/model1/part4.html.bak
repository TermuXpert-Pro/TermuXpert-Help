</footer>

    <script src="../../../../../assets/js/protection.js"></script>
    <script src="../../../../../assets/js/script.js"></script>
    
<script>
        window.addEventListener('scroll', function() {
            var navbar = document.getElementById('navbar');
            if (navbar) {
                navbar.classList.toggle('scrolled', window.scrollY > 30);
            }
        });

        function toggleSolution(id) {
            var el = document.getElementById(id);
            if (!el) return;
            var btn = el.previousElementSibling;
            if (!btn) return;
            if (el.classList.contains('show')) {
                el.classList.remove('show');
                btn.textContent = 'Voir la solution';
            } else {
                el.classList.add('show');
                btn.textContent = 'Cacher la solution';
            }
        }

        // ============================================================
        // GRAPHIQUES
        // ============================================================

        function drawCosEqGraph() {
            var canvas = document.getElementById('cosEqGraph');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width, h = canvas.height;
            var cx = w/2, cy = h/2;
            var R = 70;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#0D1117';
            ctx.fillRect(0, 0, w, h);

            // Cercle
            ctx.strokeStyle = '#4ECDC4';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, 2*Math.PI);
            ctx.stroke();

            // Axes
            ctx.strokeStyle = '#2A2A3E';
            ctx.lineWidth = 0.8;
            ctx.beginPath(); ctx.moveTo(10, cy); ctx.lineTo(w-10, cy); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(cx, 10); ctx.lineTo(cx, h-10); ctx.stroke();

            // Points π/3 et -π/3
            var val = Math.PI/3;
            var px = cx + R*Math.cos(val);
            var py = cy - R*Math.sin(val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px, py, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('π/3', px+4, py-4);

            var px2 = cx + R*Math.cos(-val);
            var py2 = cy - R*Math.sin(-val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px2, py2, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('-π/3', px2-20, py2+12);

            // Arc coloré
            ctx.strokeStyle = '#4D9DE0';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.arc(cx, cy, R, -val, val);
            ctx.stroke();

            ctx.fillStyle = '#4ECDC4';
            ctx.font = '9px Arial';
            ctx.fillText('cos x = 1/2', 20, 16);
        }

        function drawSinEqGraph() {
            var canvas = document.getElementById('sinEqGraph');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width, h = canvas.height;
            var cx = w/2, cy = h/2;
            var R = 70;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#0D1117';
            ctx.fillRect(0, 0, w, h);

            ctx.strokeStyle = '#4ECDC4';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, 2*Math.PI);
            ctx.stroke();

            ctx.strokeStyle = '#2A2A3E';
            ctx.lineWidth = 0.8;
            ctx.beginPath(); ctx.moveTo(10, cy); ctx.lineTo(w-10, cy); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(cx, 10); ctx.lineTo(cx, h-10); ctx.stroke();

            var val = Math.PI/6;
            var px = cx + R*Math.cos(val);
            var py = cy - R*Math.sin(val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px, py, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('π/6', px+4, py-4);

            var px2 = cx + R*Math.cos(Math.PI - val);
            var py2 = cy - R*Math.sin(Math.PI - val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px2, py2, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('5π/6', px2+4, py2-4);

            ctx.strokeStyle = '#4D9DE0';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.arc(cx, cy, R, val, Math.PI - val);
            ctx.stroke();

            ctx.fillStyle = '#4ECDC4';
            ctx.font = '9px Arial';
            ctx.fillText('sin x = 1/2', 20, 16);
        }

        function drawTanEqGraph() {
            var canvas = document.getElementById('tanEqGraph');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width, h = canvas.height;
            var cx = w/2, cy = h/2;
            var R = 70;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#0D1117';
            ctx.fillRect(0, 0, w, h);

            ctx.strokeStyle = '#4ECDC4';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, 2*Math.PI);
            ctx.stroke();

            ctx.strokeStyle = '#2A2A3E';
            ctx.lineWidth = 0.8;
            ctx.beginPath(); ctx.moveTo(10, cy); ctx.lineTo(w-10, cy); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(cx, 10); ctx.lineTo(cx, h-10); ctx.stroke();

            var val = Math.PI/4;
            var px = cx + R*Math.cos(val);
            var py = cy - R*Math.sin(val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px, py, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('π/4', px+4, py-4);

            var px2 = cx + R*Math.cos(val + Math.PI);
            var py2 = cy - R*Math.sin(val + Math.PI);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px2, py2, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('5π/4', px2-14, py2+12);

            // Droite OM
            ctx.strokeStyle = '#F4D03F';
            ctx.lineWidth = 1;
            ctx.setLineDash([2,2]);
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(px, py);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(px2, py2);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = '#4ECDC4';
            ctx.font = '9px Arial';
            ctx.fillText('tan x = 1', 20, 16);
        }

        function drawTransformationEqGraph() {
            var canvas = document.getElementById('transformationEqGraph');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width, h = canvas.height;
            var cx = 40, cy = h/2;
            var scaleX = (w-60) / (2*Math.PI);
            var scaleY = (h-30) / 4;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#0D1117';
            ctx.fillRect(0, 0, w, h);

            ctx.strokeStyle = '#2A2A3E';
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(cx, 10); ctx.lineTo(cx, h-10); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(w-10, cy); ctx.stroke();

            // y = √3 cos(3x) + sin(3x) + 2
            ctx.strokeStyle = '#4ECDC4';
            ctx.lineWidth = 2;
            ctx.beginPath();
            var first = true;
            for (var x = -Math.PI/2; x <= Math.PI/2; x += 0.02) {
                var y = Math.sqrt(3)*Math.cos(3*x) + Math.sin(3*x) + 2;
                var sx = cx + (x + Math.PI/2) * scaleX;
                var sy = cy - y * scaleY;
                if (first) { ctx.moveTo(sx, sy); first = false; }
                else ctx.lineTo(sx, sy);
            }
            ctx.stroke();

            // Ligne y = 0
            ctx.strokeStyle = '#FF6B6B';
            ctx.lineWidth = 1;
            ctx.setLineDash([3,3]);
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(w-10, cy);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = '#4ECDC4';
            ctx.font = '8px Arial';
            ctx.fillText('y = √3 cos(3x) + sin(3x) + 2', 10, 12);
            ctx.fillStyle = '#FF6B6B';
            ctx.fillText('y = 0', 10, 22);
        }

        function drawCosIneqGraph() {
            var canvas = document.getElementById('cosIneqGraph');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width, h = canvas.height;
            var cx = w/2, cy = h/2;
            var R = 70;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#0D1117';
            ctx.fillRect(0, 0, w, h);

            ctx.strokeStyle = '#4ECDC4';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, 2*Math.PI);
            ctx.stroke();

            ctx.strokeStyle = '#2A2A3E';
            ctx.lineWidth = 0.8;
            ctx.beginPath(); ctx.moveTo(10, cy); ctx.lineTo(w-10, cy); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(cx, 10); ctx.lineTo(cx, h-10); ctx.stroke();

            var val = Math.PI/3;
            // Zone colorée
            ctx.fillStyle = 'rgba(78, 205, 196, 0.2)';
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, R, -val, val);
            ctx.closePath();
            ctx.fill();

            var px = cx + R*Math.cos(val);
            var py = cy - R*Math.sin(val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px, py, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('π/3', px+4, py-4);

            var px2 = cx + R*Math.cos(-val);
            var py2 = cy - R*Math.sin(-val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px2, py2, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('-π/3', px2-20, py2+12);

            ctx.fillStyle = '#4ECDC4';
            ctx.font = '9px Arial';
            ctx.fillText('cos x ≥ 1/2', 20, 16);
        }

        function drawSinIneqGraph() {
            var canvas = document.getElementById('sinIneqGraph');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width, h = canvas.height;
            var cx = w/2, cy = h/2;
            var R = 70;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#0D1117';
            ctx.fillRect(0, 0, w, h);

            ctx.strokeStyle = '#4ECDC4';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, 2*Math.PI);
            ctx.stroke();

            ctx.strokeStyle = '#2A2A3E';
            ctx.lineWidth = 0.8;
            ctx.beginPath(); ctx.moveTo(10, cy); ctx.lineTo(w-10, cy); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(cx, 10); ctx.lineTo(cx, h-10); ctx.stroke();

            var val = Math.PI/6;
            ctx.fillStyle = 'rgba(78, 205, 196, 0.2)';
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, R, val, Math.PI - val);
            ctx.closePath();
            ctx.fill();

            var px = cx + R*Math.cos(val);
            var py = cy - R*Math.sin(val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px, py, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('π/6', px+4, py-4);

            var px2 = cx + R*Math.cos(Math.PI - val);
            var py2 = cy - R*Math.sin(Math.PI - val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px2, py2, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('5π/6', px2+4, py2-4);

            ctx.fillStyle = '#4ECDC4';
            ctx.font = '9px Arial';
            ctx.fillText('sin x ≥ 1/2', 20, 16);
        }

        function drawTanIneqGraph() {
            var canvas = document.getElementById('tanIneqGraph');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width, h = canvas.height;
            var cx = w/2, cy = h/2;
            var R = 70;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#0D1117';
            ctx.fillRect(0, 0, w, h);

            ctx.strokeStyle = '#4ECDC4';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, 2*Math.PI);
            ctx.stroke();

            ctx.strokeStyle = '#2A2A3E';
            ctx.lineWidth = 0.8;
            ctx.beginPath(); ctx.moveTo(10, cy); ctx.lineTo(w-10, cy); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(cx, 10); ctx.lineTo(cx, h-10); ctx.stroke();

            var val = Math.PI/4;
            ctx.fillStyle = 'rgba(78, 205, 196, 0.2)';
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, R, val, Math.PI/2);
            ctx.closePath();
            ctx.fill();

            ctx.fillStyle = 'rgba(78, 205, 196, 0.2)';
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, R, Math.PI + val, 3*Math.PI/2);
            ctx.closePath();
            ctx.fill();

            var px = cx + R*Math.cos(val);
            var py = cy - R*Math.sin(val);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px, py, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('π/4', px+4, py-4);

            var px2 = cx + R*Math.cos(val + Math.PI);
            var py2 = cy - R*Math.sin(val + Math.PI);
            ctx.fillStyle = '#F4D03F';
            ctx.beginPath();
            ctx.arc(px2, py2, 4, 0, 2*Math.PI);
            ctx.fill();
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '9px Arial';
            ctx.fillText('5π/4', px2-14, py2+12);

            ctx.strokeStyle = '#F4D03F';
            ctx.lineWidth = 1;
            ctx.setLineDash([2,2]);
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(px, py);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(px2, py2);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = '#4ECDC4';
            ctx.font = '9px Arial';
            ctx.fillText('tan x ≥ 1', 20, 16);
        }

        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                drawCosEqGraph();
                drawSinEqGraph();
                drawTanEqGraph();
                drawTransformationEqGraph();
                drawCosIneqGraph();
                drawSinIneqGraph();
                drawTanIneqGraph();
            }, 300);
        });
    </script>
</body>
</html>